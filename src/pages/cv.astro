---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/global.css";

const mkHref = (p) => {
  if (!p) return p;
  if (/^https?:\/\//.test(p)) return p;

  const cleaned = p.replace(/^\/+/, "");

  return `${import.meta.env.BASE_URL}${encodeURI(cleaned)}`;
};
---
<MainLayout title="CV — Federico D'Onofrio">

  <h1>CV</h1>

  <p>
    <a
  href={mkHref("cv/federico-donofrio-cv.pdf")}
  target="_blank"
  rel="noopener noreferrer"
>
  Download CV [--&gt;]
</a>
  </p>

  <section>
    <h2 class="section-title">Current positions</h2>

    <p>
      Associate Professor of the History of Economic Thought<br />
      Department of Political and Social Sciences<br />
      University of Bologna
    </p>

    
  </section>

  <section>
    <h2 class="section-title">Research interests</h2>

    <p>
      Intellectual history<br />
      History of political economy<br />
      Global history<br />
      Rural history<br />
      History of quantification<br />
      Economic history
    </p>
  </section>

  <section>
    <h2 class="section-title">Grants, fellowships and awards</h2>

    <p>
      ERC Starting Grant, 2021–2026<br />
      “Leading the first data revolution in European agriculture”
    </p>

    <p>
      Marie Skłodowska-Curie Individual Fellowship, 2018–2019<br />
      “Farm Accountancy Data as a Source for the History of European Agriculture”
    </p>
  </section>

  <section>
    <h2 class="section-title">Education</h2>

    <p>
      PhD, Utrecht University, 2012<br />
      <em>Knowing to Transform: three ways for agricultural economists
      to observe Italy 1900–1940</em>
    </p>

    <p>
      M.Sc. in Economics, CORIPE Piemonte, 2008
    </p>

    <p>
      Laurea magistrale in Philosophy, Università di Pisa, 2007
    </p>
  </section>

</MainLayout>